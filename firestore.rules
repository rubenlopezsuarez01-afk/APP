rules_version = '2';

// Reglas de Firestore para el Planning de comidas.
// Cada espacio compartido vive en hogares/<código> y solo se puede leer o
// escribir conociendo su código (20 caracteres aleatorios). No se puede
// listar qué espacios existen.
service cloud.firestore {
  match /databases/{database}/documents {
    match /hogares/{code}/{document=**} {
      allow read, write: if code.size() == 20 && code.matches('^[A-Z2-9]+$');
    }
  }
}
